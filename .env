# API URL
# For iOS Simulator: http://localhost:8000/api
# For Android Emulator: http://10.0.2.2:8000/api
# For Physical Device: http://<YOUR_MACHINE_IP>:8000/api
EXPO_PUBLIC_API_BASE_URL=http://2.24.141.110/api
# Expo SDK 57's WinterCG fetch does not support React Native's local-file
# multipart parts ({ uri, name, type }). Keep the native fetch implementation
# for FormData uploads such as meter-reading evidence photos.
EXPO_PUBLIC_USE_RN_FETCH=1
